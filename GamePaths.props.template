<Project>
  <!-- Copy this file to GamePaths.props and set GameDir to your Endless Space 2 install.
       Both blocks may stay: the OS conditions make each side of a checkout shared between
       Windows and macOS (a VM, a dual boot) read only its own block. MSBuild would otherwise
       let the LAST definition win on both systems, silently pointing one side's build at the
       other's game. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Endless Space 2</GameDir>
    <Managed>$(GameDir)\EndlessSpace2_Data\Managed</Managed>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <!-- On macOS the game is an .app bundle and BepInEx sits next to it (see macos/README.md). -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <GameDir>$(HOME)/Library/Application Support/Steam/steamapps/common/Endless Space 2</GameDir>
    <Managed>$(GameDir)/EndlessSpace2.app/Contents/Resources/Data/Managed</Managed>
    <BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
  </PropertyGroup>
</Project>
