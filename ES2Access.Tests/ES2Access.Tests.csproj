<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline unit tests for the engine-free half of the mod. No Unity, no BepInEx, no game launch.
    There is no Core assembly to reference: the plugin's Core/ and ES2/ sources are LINKED and
    compiled directly into this test assembly, so anything under either that reached for Unity,
    BepInEx or the game would break this build. That is the point — Core (the game-agnostic
    framework) and ES2 (this game's own tables and wordings) both stay BCL-only, and the tests run
    on a modern runtime without the game installed.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ES2Access.Tests</AssemblyName>
    <RootNamespace>ES2Access.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ES2Access\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\ES2Access\ES2\**\*.cs" LinkBase="ES2" />
    <!--
      The mod's ACTION NAMES and the Controls tab's LAYOUT over them. They live under UI\ because
      that is who registers and draws them, but the four files are plain string tables with no
      engine in them, so they are linked here too: "every key the mod has is on the settings page
      exactly once" is a question that can be answered with no game running, and it is a question
      whose wrong answer is a binding the player cannot see.
    -->
    <Compile Include="..\ES2Access\UI\Input\UiActions.cs" LinkBase="Input" />
    <Compile Include="..\ES2Access\UI\Input\MapActions.cs" LinkBase="Input" />
    <Compile Include="..\ES2Access\UI\Input\BufferActions.cs" LinkBase="Input" />
    <Compile Include="..\ES2Access\UI\Input\KeybindLayout.cs" LinkBase="Input" />
  </ItemGroup>
</Project>
