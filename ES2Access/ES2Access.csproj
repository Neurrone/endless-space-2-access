<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../GamePaths.props" Condition="Exists('../GamePaths.props')" />

  <PropertyGroup>
    <!-- ES2 runs Unity 5.5 / Mono with the .NET 2.0/3.5 API profile; the plugin must target net35. -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>ES2Access</AssemblyName>
    <RootNamespace>ES2Access</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <!-- The mod's single version source: the build stamps it into the assembly and ModEntry reads it
         back, so nothing in the sources carries a second copy. Without the second line a newer SDK
         appends "+<git sha>" to the informational version, which would be spoken at startup. -->
    <Version>0.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>full</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <PluginDir>$(GameDir)/BepInEx/plugins/ES2Access</PluginDir>
    <!-- Beside obj/mac (Directory.Build.props): a macOS build never shares an output folder with a Windows one. -->
    <OutputPath Condition="$([MSBuild]::IsOSPlatform('OSX'))">bin/mac/$(Configuration)/</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(Managed)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Managed)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Managed)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(Managed)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The dev server writes JSON with the copy of Newtonsoft.Json the game already loads. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(Managed)/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Amplitude">
      <HintPath>$(Managed)/Amplitude.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The loader is the BepInEx plugin and deploys itself; this project only compiles against
         its ModHost contract, so nothing of it is copied here. -->
    <ProjectReference Include="../ES2Access.Loader/ES2Access.Loader.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)')">
    <ItemGroup>
      <!-- Translation tables, named after the game's own language names (locale\french.json). -->
      <LocaleFile Include="$(MSBuildThisFileDirectory)locale/*.json" />
      <!-- Cutscene audio descriptions, named the same way and built from the authoring folder by
           build-descriptions.ps1. Unlike the translations, english.json is not optional: there are
           no built-in descriptions for it to fall back to. -->
      <DescriptionFile Include="$(MSBuildThisFileDirectory)descriptions/*.json" />
    </ItemGroup>
    <!-- Overwritten while the game is running: the loader holds no lock on it, so POST /reload
         picks up whatever this last copied. -->
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(PluginDir)" />
    <Copy SourceFiles="@(LocaleFile)" DestinationFolder="$(PluginDir)/locale" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DescriptionFile)" DestinationFolder="$(PluginDir)/descriptions" SkipUnchangedFiles="true" />
    <!-- Windows speaks through the vendored prism.dll; on macOS the system voice (Core/Speech/Mac)
         is the primary and the fetched libprism.dylib is deployed as the fallback backend. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../vendor/prism/prism.dll" DestinationFiles="$(GameDir)/prism.dll" SkipUnchangedFiles="true" Condition="!$([MSBuild]::IsOSPlatform('OSX'))" />
    <Copy SourceFiles="$(PrismBuildDir)/libprism.dylib" DestinationFiles="$(GameDir)/libprism.dylib" SkipUnchangedFiles="true" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <!-- macOS only: the launcher players point Steam at (macos/README.md); Exec keeps it executable, Copy would not. -->
    <Exec Command="install -m 755 &quot;$(MSBuildThisFileDirectory)../macos/run-modded.sh&quot; &quot;$(GameDir)/run-modded.sh&quot;" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </Target>

  <!-- macOS only: a PR should not carry a second 1.5 MB Prism binary, so libprism.dylib comes
       from the pinned GitHub release (the same version as the vendored prism.dll and the enums
       in Core/Speech/PrismNative.cs, vendor/prism/prism_version.h) into the gitignored
       prism-build/, once; only a version bump or a deleted folder re-downloads. -->
  <PropertyGroup>
    <PrismVersion>v0.18.1</PrismVersion>
    <PrismBuildDir>$(MSBuildThisFileDirectory)../prism-build</PrismBuildDir>
    <PrismStampFile>$(PrismBuildDir)/version.txt</PrismStampFile>
    <PrismFetchedVersion Condition="Exists('$(PrismStampFile)')">$([System.IO.File]::ReadAllText('$(PrismStampFile)').Trim())</PrismFetchedVersion>
  </PropertyGroup>
  <Target Name="FetchPrism" BeforeTargets="DeployToGame" Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(GameDir)') And ('$(PrismFetchedVersion)' != '$(PrismVersion)' Or !Exists('$(PrismBuildDir)/libprism.dylib'))">
    <DownloadFile SourceUrl="https://github.com/ethindp/prism/releases/download/$(PrismVersion)/prism-macos-universal.zip" DestinationFolder="$(PrismBuildDir)/download" DestinationFileName="$(PrismVersion)-prism-macos-universal.zip" SkipUnchangedFiles="true" />
    <Unzip SourceFiles="$(PrismBuildDir)/download/$(PrismVersion)-prism-macos-universal.zip" DestinationFolder="$(PrismBuildDir)/download/$(PrismVersion)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(PrismBuildDir)/download/$(PrismVersion)/dynamic/release/lib/libprism.dylib" DestinationFolder="$(PrismBuildDir)" />
    <WriteLinesToFile File="$(PrismStampFile)" Lines="$(PrismVersion)" Overwrite="true" />
    <Message Text="Prism $(PrismVersion) fetched into $(PrismBuildDir)" Importance="high" />
  </Target>
</Project>
